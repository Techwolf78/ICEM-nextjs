<IfModule mod_rewrite.c>
  RewriteEngine On

  # Rewrite Next.js static RSC prefetch requests with dots to nested directory structure
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)/__next\.([^.]+)\.([^.]+)\.__PAGE__\.txt$ $1/__next.$2/$3/__PAGE__.txt [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)/__next\.([^.]+)\.__PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)/__next\.([^.]+)\.([^.]+)\.txt$ $1/__next.$2/$3.txt [L]

  # Case-insensitive resolution for programs/MBA assets
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/programs/mba/$1 -f
  RewriteRule ^programs/[mM][bB][aA]/(.*)$ /programs/mba/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/programs/MBA/$1 -f
  RewriteRule ^programs/[mM][bB][aA]/(.*)$ /programs/MBA/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/programs/$1 -f
  RewriteRule ^[pP]rograms/(.*)$ /programs/$1 [L]
</IfModule>

<IfModule mod_speling.c>
  CheckCaseOnly On
</IfModule>

ErrorDocument 404 /404.html